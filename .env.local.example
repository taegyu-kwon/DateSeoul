# Postgres (Supabase: Settings → Database → Connection string)
# - DATABASE_URL: "Transaction" pooler (port 6543, pgbouncer) — good for Next.js server / serverless.
# - DIRECT_URL: "Session" direct (port 5432) — required for prisma migrate / db push.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require"
# If you only have one direct Postgres URL (no pooler), use the same value for DATABASE_URL and DIRECT_URL.
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Password reset emails (Resend). If unset, dev server logs the reset link to the terminal.
# https://resend.com — create API key; use a verified domain or onboarding@resend.dev for testing.
RESEND_API_KEY=
EMAIL_FROM="Date Seoul <onboarding@resend.dev>"
# Public site URL for links in emails (e.g. https://your-domain.com)
NEXT_PUBLIC_APP_URL=http://localhost:3000

ANTHROPIC_API_KEY=your_key_here
# Kakao Maps: use JavaScript key from Kakao Developers; register your dev origin (e.g. http://localhost:3000).
NEXT_PUBLIC_KAKAO_MAP_KEY=your_javascript_key_here
